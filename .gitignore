# 인증은 각자 OAuth 로그인으로 처리된다)
!.mcp.json

# ==========================================================================
# Checked-in editor binaries (double-click .uproject workflow)
# --------------------------------------------------------------------------
# Development editor DLLs + .modules manifests are committed so teammates
# can open the project by double-clicking ChronoSpace.uproject without
# Visual Studio. Whoever changes C++ must rebuild and commit these files.
# Everything else under Binaries/ (DebugGame, Shipping, PDBs, live-coding
# patches) stays ignored. This block must stay at the END of .gitignore so
# it wins over the global *.dll rules above (last match wins).
# ==========================================================================
!Binaries/Win64/
Binaries/Win64/*
!Binaries/Win64/UnrealEditor-ChronoSpace.dll
!Binaries/Win64/UnrealEditor.modules
!Binaries/Win64/ChronoSpaceEditor.target

!Plugins/*/Binaries/Win64/
Plugins/*/Binaries/Win64/*
!Plugins/*/Binaries/Win64/UnrealEditor-*.dll
!Plugins/*/Binaries/Win64/UnrealEditor.modules
!Plugins/*/Binaries/Win64/EOSSDK-Win64-Shipping.dll
# ...but never DebugGame variants, and not the disabled Steam sessions plugin
Plugins/*/Binaries/Win64/UnrealEditor-*-Win64-DebugGame.dll
Plugins/AdvancedSteamSessions/Binaries/

# ==========================================================================
# Claude Code
# .claude/ 는 기본적으로 전부 무시한다. 개인 설정/룰/스킬은 이름을 아무렇게나
# 지어도 커밋되지 않는다.
#
# 팀과 공유할 룰/스킬은 아래에 직접 예외를 추가할 것. 폴더와 내용물 두 줄이 필요하다.
#   !.claude/skills/<이름>/
#   !.claude/skills/<이름>/**
# ==========================================================================
CLAUDE.local.md
.claude/**

